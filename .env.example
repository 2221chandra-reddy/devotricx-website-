DATABASE_URL="file:./dev.db"
AUTH_SECRET="devotricx-careers-secret-change-in-production"
APP_URL="http://localhost:3000"

# --- For LIVE (Vercel): use Neon Postgres instead of SQLite ---
# 1) Create free DB: https://console.neon.tech
# 2) Copy connection string (URI)
# 3) In Vercel → Settings → Environment Variables set:
#    DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#    AUTH_SECRET=any-long-random-secret
#    APP_URL=https://www.devotrix.com
# 4) Redeploy

